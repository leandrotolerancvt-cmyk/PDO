<?php

require_once 'dbconfig.php';                       // load the $pdo connection

// Prepared INSERT with named placeholders (protects against SQL injection)
$sql = "INSERT INTO grocery_items
            (item_name, brand_name, category_id, unit_size, price_idr, stock_quantity, expiration_date)
        VALUES
            (:item_name, :brand_name, :category_id, :unit_size, :price_idr, :stock_quantity, :expiration_date)";
$stmt = $pdo->prepare($sql);

$stmt->execute([                                   // supply the values for each placeholder
    ':item_name'       => 'Indomie Mi Goreng Special',
    ':brand_name'      => 'Indomie',
    ':category_id'     => 1,                       // 1 = Instant Noodles
    ':unit_size'       => '85 g',
    ':price_idr'       => 3600,
    ':stock_quantity'  => 150,
    ':expiration_date' => '2027-08-30',
]);

echo 'Record inserted. New item_id: ' . $pdo->lastInsertId();  // id generated by AUTO_INCREMENT
