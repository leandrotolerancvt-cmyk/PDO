-- ============================================================
-- Indonesian Grocery Items Database (MySQL / MariaDB)
-- PDO Methods Activity - Country: Indonesia
-- Prices are approximate retail prices in Indonesian Rupiah (IDR).
-- ============================================================

DROP DATABASE IF EXISTS indonesia_grocery;
CREATE DATABASE indonesia_grocery CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE indonesia_grocery;

CREATE TABLE categories (
    category_id   INT UNSIGNED NOT NULL AUTO_INCREMENT,
    category_name VARCHAR(50)  NOT NULL,
    description   VARCHAR(150) NULL,
    PRIMARY KEY (category_id),
    UNIQUE KEY uq_category_name (category_name)
) ENGINE=InnoDB;

CREATE TABLE grocery_items (
    item_id         INT UNSIGNED  NOT NULL AUTO_INCREMENT,
    item_name       VARCHAR(100)  NOT NULL,
    brand_name      VARCHAR(50)   NOT NULL,
    category_id     INT UNSIGNED  NOT NULL,
    unit_size       VARCHAR(30)   NOT NULL,
    price_idr       DECIMAL(10,2) NOT NULL,
    stock_quantity  INT UNSIGNED  NOT NULL DEFAULT 0,
    expiration_date DATE          NOT NULL,
    date_added      TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (item_id),
    KEY idx_brand (brand_name),
    CONSTRAINT fk_items_category FOREIGN KEY (category_id)
        REFERENCES categories (category_id)
) ENGINE=InnoDB;

